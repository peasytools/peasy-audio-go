# peasy-audio-go — Audio trim, merge, convert (Go)
# Theme: Nord
# Generated for AgentGIF demo collection

Output demo.gif
Set Shell "zsh"
Set Theme "nord"
Set Width 800
Set Height 500
Set FontSize 14
Set Padding 20
Set TypingSpeed 50ms

# Show package info
Type "# peasy-audio-go — Audio trim, merge, convert for Go"
Enter
Type "# peasyaudio.com"
Enter
Sleep 500ms

# Run the demo
Type "go run ./examples/demo/"
Enter
Sleep 5s
